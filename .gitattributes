# Auto-detect text files, normalize line endings
* text=auto

# Python files: always LF in repo, native in working tree
*.py text eol=lf
*.pyi text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.db binary
*.sqlite binary
